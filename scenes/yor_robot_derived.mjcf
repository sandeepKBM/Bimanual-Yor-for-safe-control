                            <site name="left_arm_ee" pos="0.0 0.0 0.0" euler="0 -1.57 0" />
                            <!-- 7.8mm -->
                            <body name="left_arm_gripper_base" pos="0.0275 0.01875 0.0798"
                              euler="3.14 -1.57 0" gravcomp="1">
                              <inertial pos="-0.000183807 8.05033e-05 0.0321437"
                                quat="0.999976 9.08444e-05 0.00689649 0.000788512"
                                mass="0.45"
                                diaginertia="0.000929442 0.000714469 0.000394318" />
                              <!-- FIDELITY FIX (restore full housing): back to gripper_body
                                   (full housing + jaws mesh, same as upstream) for BOTH visual
                                   and collision -- the earlier gripper_base swap (mounting
                                   flange only) left ~6.3cm of the gripper with no geometry,
                                   undersizing the arm-arm collision footprint. Finger bodies
                                   below stay real/actuated (unlike upstream's static mesh).
                                   Kept class="collision" (fitted-capsule proxy, ships
                                   contype=0/conaffinity=1) rather than upstream's
                                   "collision_gripper" (full-mesh, default contype/conaffinity=1):
                                   sim_common._patch_real_collision_geoms (wired into
                                   load_yor_cup_collect_model / load_yor_cup_model) keys off
                                   contype==0 && conaffinity==1 on left_arm_*/right_arm_* geoms
                                   and rewrites them to dedicated left/right bits, so the patched
                                   gripper_body collides with the OTHER arm only -- never with
                                   own-side geoms, the table, or (since cup/ball/cube ship
                                   contype=1/conaffinity=1, sharing no bit with the patch) the
                                   kinematically-pinned grasped cup/balls/cubes. Using
                                   collision_gripper here would skip that patch and leave the
                                   real housing mesh colliding with everything. -->
                              <geom mesh="gripper_body" class="visual" material="gray_mat" />
                              <geom mesh="gripper_body" class="collision" />
                              <site name="left_arm_ee_grasp" pos="0 0 0.1" euler="0 -1.5708 0" size="0.001" rgba="1 0 0 1" />
                              <!-- ADDED: actuated parallel-jaw fingers (left_arm_joint7/8). -->
                              <body name="left_arm_link7" pos="0 0 0.1358" quat="0.707105 0.707108 0 0" gravcomp="1">
                                <inertial pos="0.000651232 -0.049193 0.00972259"
                                  quat="0.477798 0.572974 -0.518028 0.418398" mass="0.025"
                                  diaginertia="7.74531e-05 7.36783e-05 5.0886e-06" />
                                <joint name="left_arm_joint7" class="finger" axis="0 0 1" range="0 0.035" />
                                <!-- visual mesh REMOVED: gripper_body's restored housing mesh
                                     already renders the jaws -- keeping this too double-rendered
                                     the fingertip. Collision geoms (below) are untouched. -->
                                <geom type="box" size=".012 .015 .0025" pos="0 -0.015 0.0025" rgba="1 0 0 .2" class="collision" />
                                <geom name="left_arm_link7_pad" type="box" size=".015 .015 .0025" pos="0 -0.045 0.0025"
                                  rgba="0 0 1 .2" class="collision" friction="2 0.02 0.0002" condim="4" priority="1"
                                  solref="0.005 1" solimp="0.95 0.99 0.001" />
                              </body>
                              <body name="left_arm_link8" pos="0 0 0.1358" quat="-2.59734e-06 -2.59735e-06 -0.707108 -0.707105" gravcomp="1">
                                <inertial pos="0.000651232 -0.049193 0.00972259"
                                  quat="0.477798 0.572974 -0.518028 0.418398" mass="0.025"
                                  diaginertia="7.74531e-05 7.36783e-05 5.0886e-06" />
                                <joint name="left_arm_joint8" class="finger" axis="0 0 -1" range="-0.035 0" />
                                <!-- visual mesh REMOVED: see left_arm_link7 comment above. -->
                                <geom type="box" size=".012 .015 .0025" pos="0 -0.015 0.0025" rgba="1 0 0 .2" class="collision" />
                                <geom name="left_arm_link8_pad" type="box" size=".015 .015 .0025" pos="0 -0.045 0.0025"
                                  rgba="0 0 1 .2" class="collision" friction="2 0.02 0.0002" condim="4" priority="1"
                                  solref="0.005 1" solimp="0.95 0.99 0.001" />
                              </body>

                              <body name="left_arm_iphone_body" pos="-0.0075 0.015 0.017" euler="0 0 1.57"
                                gravcomp="1">
                                <!-- VISUAL FIX: the upstream "iphone" mesh (a real, full-size
                                     phone -- ~12x75x148mm) reads as a large floating/detached
                                     slab at wrist scale. Swapped the VISUAL geom only for a
                                     compact box "camera housing" at the same body
                                     pos/euler/location (no pos/quat on the geom, same as
                                     before) so it reads as a neatly-mounted wrist camera.
                                     class="collision" iphone geom below is UNCHANGED (still the
                                     full mesh, group=3, untouched collision proxy). The
                                     left_arm_camera_body / left_arm_egocentric camera nested
                                     below is untouched -- this body's pos/euler did not change,
                                     so the camera's pose is byte-identical. -->
                                <geom type="box" size="0.008 0.010 0.014" class="visual" material="gray" />
                                <geom mesh="iphone" class="collision" />

                                <body name="left_arm_camera_body" pos="0.0 -0.036 0.1"
                                  euler="-0.2617993878 3.14159265359 0.0" gravcomp="1">
                                  <site name="left_arm_ee_iphone" pos="0.0 0.0 0.0" euler="3.14 0 -1.57" />
                                  <geom type="box" size="0.01 0.01 0.01" rgba="0.1 0.5 0.1 0" contype="0" conaffinity="0" />
                                  <camera name="left_arm_egocentric" mode="fixed" fovy="53.1" />
                                </body>
                              </body>
                            </body>
                          </body>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>
              </body>

            <body name="right_arm_link0" euler="-0.7854 0 3.14" pos="-0.005 0.0925 0.0575" childclass="piper" gravcomp="1">
