<mujoco model="yor-derived">
  <!--
  DERIVED COPY -- do not confuse with the read-only original.
  Source: YOR/robot/yor-description/robot-welded-base-and-lift.mjcf (untouched, still present).
  This copy exists solely to add ACTUATED gripper fingers, which the upstream
  model does not have (its "gripper_body" mesh is one static combined mesh with
  fingers baked in, not decomposable into a joint). Changes vs. upstream:
    1. compiler: added a meshdir relative to scenes/ (this file lives under scenes/, not
       next to YOR's meshes/ dir); all upstream mesh <file> paths are unchanged.
    2. default: added a "finger" default class (slide joint, position servo),
       ported from scenes/bimanual_piper_pickup.xml / YOR's coney.xml precedent.
    3. asset: added link7/link8 meshes, pointed (path relative to meshdir) at
       YOR/robot/arm/mujoco/assets/{link7,link8}.stl -- the decomposed Piper
       finger meshes that yor-description/meshes/piper/ does not ship (it only
       has the combined gripper_body.stl). No files copied/duplicated.
    4. left_arm_gripper_base / right_arm_gripper_base: swapped the geom mesh
       from "gripper_body" (static, fingers-in-mesh) to "gripper_base"
       (fingers-free) -- this exact swap is pre-staged, commented out, in
       YOR/robot/arm/mujoco/piper_left.xml at the identical body pose -- and
       added left_arm_link7/8 and right_arm_link7/8 as new child bodies with
       left/right_arm_joint7 (slide, axis 0 0 1, range 0..0.035) and joint8
       (slide, axis 0 0 -1, range -0.035..0), plus a friction-tuned pad geom on
       each finger tip (friction "2 0.02 0.0002", condim 4) so they can grip.
       Also added *_ee_grasp sites at the fingertip midpoint (pos 0 0 0.1 in
       gripper_base frame) for grasp-centric IK/monitoring.
    5. actuator: added left/right_arm_joint7_pos, left/right_arm_joint8_pos
       position actuators (class "finger", kp=200, forcerange -20..20).
       No tendon/equality coupling -- command both joints of one gripper
       together (0,0)=closed, (0.035,-0.035)=open, matching
       scenes/bimanual_piper_pickup.xml's convention.
    6. Dropped the upstream <keyframe> (sized for nq=12/16 of this file alone);
       an equivalent keyframe covering the full scene (arms + fingers + box)
       is defined in scenes/scene_yor_canonical.xml instead.
  Everything else (base/lift bodies, wheels, contact excludes, sensors,
  wrist cameras left_arm_egocentric/right_arm_egocentric, front_camera/
  side_camera) is byte-for-byte identical to the upstream file.
  -->
  <compiler angle="radian" meshdir="../YOR/robot/yor-description" />
  <option integrator="implicitfast" cone="elliptic" impratio="10" gravity="0 0 -9.81" timestep="0.005" />
  <default>
    <default class="robot">
      <default class="motor">
        <joint />
        <motor />
      </default>
      <default class="steering_joint">
        <position kp="10" kv="1" inheritrange="1" />
        <joint frictionloss="0.001" range="-3.14159 3.14159" />
      </default>
      <default class="drive_joint">
        <velocity kv="1" />
        <joint frictionloss="0.001" />
      </default>
      <default class="visual">
        <geom material="visualgeom" type="mesh" contype="0" conaffinity="0" group="2" density="0"/>
      </default>
      <default class="collision">
        <geom type="capsule" condim="3" contype="0" conaffinity="1" priority="1" group="3" solref="0.005 1"
          friction="1 0.01 0.01" />
        <equality solimp="0.99 0.999 1e-05" solref="0.005 1" />
      </default>
      <default class="wheel">
        <!-- 4 is friction that opposes rotation around the contact normal -->
        <geom type="mesh" condim="4" contype="0" conaffinity="1" priority="1" group="3" solref="0.005 1"
          friction="1.2 0.005 0.005" />
      </default>

      <default class="telescope">
        <joint type="slide" axis="0 0 1" damping="50" stiffness="0.02" armature="0.01" range="0 0.208" frictionloss="1.5"/>
        <general ctrlrange="0 0.416" gainprm="150" biasprm="0 -100 -10" forcerange="-56 56"/>
      </default>
    </default>


    <default class="piper">
      <joint frictionloss="0.3" armature="0.005" />
      <position inheritrange="1" forcerange="-100 100" />
      <default class="collision_gripper">
        <geom type="mesh" group="3" friction="2 0.005 0.0001" density="100" />
      </default>
      <!-- ADDED: actuated parallel-jaw finger default (ported from
           scenes/bimanual_piper_pickup.xml, itself ported from YOR's own
           coney.xml joint7/joint8 precedent). -->
      <default class="finger">
        <joint type="slide" frictionloss="0.05" damping="100" />
        <position forcerange="-20 20" kp="200" />
      </default>
    </default>
  </default>


  <asset>
    <!-- base and lift assets -->
    <material name="base_material" rgba="1 0 0 1" />
    <material name="base_profile_short_material" rgba="0.701961 0.701961 0.701961 1" />
    <material name="Part_2_material" rgba="0.615686 0.811765 0.929412 1" />
    <material name="MK4_Colson_Hub_4_X_1.5_material" rgba="0.666667 0.698039 0.768627 1" />
    <material name="Lift_Middle_material" rgba="0.901961 0.901961 0.901961 1" />
    <material name="default_material" rgba="0.7 0.7 0.7 1" />

    <mesh name="base_profile_short.stl" file="meshes/base_profile_short.stl" />
    <mesh name="Part_2.stl" file="meshes/Part_2.stl" />
    <mesh name="MK4_Colson_Hub_4_X_1.5.stl" file="meshes/MK4_Colson_Hub_4_X_1.5.stl" />
    <mesh name="Part_2_2.stl" file="meshes/Part_2_2.stl" />
    <mesh name="MK4_Colson_Hub_4_X_1.5_2.stl" file="meshes/MK4_Colson_Hub_4_X_1.5_2.stl" />
    <mesh name="Part_2_3.stl" file="meshes/Part_2_3.stl" />
    <mesh name="MK4_Colson_Hub_4_X_1.5_3.stl" file="meshes/MK4_Colson_Hub_4_X_1.5_3.stl" />
    <mesh name="Part_2_4.stl" file="meshes/Part_2_4.stl" />
    <mesh name="MK4_Colson_Hub_4_X_1.5_4.stl" file="meshes/MK4_Colson_Hub_4_X_1.5_4.stl" />
    <mesh name="Lift_Middle.stl" file="meshes/Lift_Middle.stl" />
    <mesh name="Lift_Top.stl" file="meshes/Lift_Top.stl" />

    <!-- piper assets -->
    <material name="white" rgba="1 1 1 1" />
    <material name="gray" rgba="0.15 0.15 0.15 1" />
    <material name="light_gray" rgba="0.6 0.6 0.6 1" />
    <material name="light_blue" rgba="0.345 0.65 0.976 1" />
    <material name="black" rgba="0.05 0.05 0.05 1" />
    <material name="gray_mat" rgba="0.59 0.59 0.59 1" />
    <material name="dark_gray_mat" rgba="0.086 0.086 0.086 1" />
    <material name="light_medium_gray_mat" rgba="0.85 0.85 0.85 1" />

    <mesh name="link0" file="meshes/piper/link0.stl" />
    <mesh name="link1" file="meshes/piper/link1.stl" />
    <mesh name="link2" file="meshes/piper/link2.stl" />
    <mesh name="link3" file="meshes/piper/link3.stl" />
    <mesh name="link4" file="meshes/piper/link4.stl" />
    <mesh name="link5" file="meshes/piper/link5.stl" />
    <mesh name="link6" file="meshes/piper/link6.stl" />
    <mesh name="gripper_base" file="meshes/piper/gripper_base.stl" />
    <mesh name="gripper_body" file="meshes/piper/gripper_body.stl" scale="0.001 0.001 0.001" />
    <mesh name="iphone" file="meshes/piper/iphone.stl" scale="0.001 0.001 0.001" />
    <!-- ADDED: finger meshes for actuated gripper (not present in yor-description/meshes/piper;
         ported from YOR/robot/arm/mujoco/assets/, same Piper gripper geometry/scale). -->
    <mesh name="link7" file="../arm/mujoco/assets/link7.stl" />
    <mesh name="link8" file="../arm/mujoco/assets/link8.stl" />
  </asset>

  <worldbody>
    <body name="base" pos="0.00000000 0.00000000 0.10477502" euler="0 1.57 0" childclass="robot">
      <!-- <freejoint name="floating_base" /> -->
      <geom name="base_visual" pos="0 0 0" quat="1.0 0.0 0.0 0.0" material="base_material"
