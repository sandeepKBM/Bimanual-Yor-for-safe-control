    <!-- <velocity name="joint5_vel" joint="joint5" kv="1.5" />
    <motor name="joint5_torque" joint="joint5" /> -->
    <position name="right_arm_joint6_pos" joint="right_arm_joint6" class="piper" kp="5" kv="1" />
    <!-- <velocity name="joint6_vel" joint="joint6" kv="1.5" />
    <motor name="joint6_torque" joint="joint6" /> -->

    <!-- ADDED: actuated parallel-jaw gripper fingers. (0,0) = closed;
         (0.035,-0.035) = open. Command both joints of a gripper together. -->
    <position name="left_arm_joint7_pos" joint="left_arm_joint7" class="finger" />
    <position name="left_arm_joint8_pos" joint="left_arm_joint8" class="finger" />
    <position name="right_arm_joint7_pos" joint="right_arm_joint7" class="finger" />
    <position name="right_arm_joint8_pos" joint="right_arm_joint8" class="finger" />
