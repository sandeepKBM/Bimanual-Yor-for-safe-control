                            <geom mesh="gripper_body" class="visual" material="gray_mat" />
                            <geom mesh="gripper_body" class="collision" />
                            <site name="right_arm_ee_grasp" pos="0 0 0.1" euler="0 -1.5708 0" size="0.001" rgba="1 0 0 1" />
                            <!-- ADDED: actuated parallel-jaw fingers (right_arm_joint7/8). -->
