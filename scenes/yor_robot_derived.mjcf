                          <joint name="right_arm_joint6" axis="0 0 1" range="-3 3" />
                          <geom class="visual" mesh="link6"
                            material="light_medium_gray_mat" />
                          <geom class="collision" mesh="link6" />
                          <site name="right_arm_ee" pos="0.0 0.0 0.0" euler="0 -1.57 0" />
                          <!-- 7.8mm -->
                          <body name="right_arm_gripper_base" pos="0.0275 0.01875 0.0798"
                            euler="3.14 -1.57 0" gravcomp="1">
                            <inertial pos="-0.000183807 8.05033e-05 0.0321437"
                              quat="0.999976 9.08444e-05 0.00689649 0.000788512"
                              mass="0.45"
                              diaginertia="0.000929442 0.000714469 0.000394318" />
                            <!-- FIDELITY FIX: see left_arm_gripper_base comment above (same
