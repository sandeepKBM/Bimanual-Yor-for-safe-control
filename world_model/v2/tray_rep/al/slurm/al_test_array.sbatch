#!/usr/bin/env bash
#SBATCH --job-name=altest
#SBATCH --partition=unlimited
#SBATCH --mem=8G
#SBATCH --time=06:00:00
#SBATCH --exclude=rlab1,ilab1
#SBATCH --output=/common/users/ss5772/bimanual_data/tray_rep/al/logs/slurm_%x_%A_%a.out
# AL-1: TEST array of the safe active-learning policies (al/policies.py) via al/run_al.py, both regimes, 3 seeds, 4 shards x 600 TEST carries.
# Fixed physics (data_piper_trk_full_v2, calib_v2 mu_eff map, F5 eps_a=0). One run per line of al_test_tasks.txt (generated by al/make_tasks_al.py).
# Submit (NOT submitted by the author):  sbatch --array=0-N world_model/v2/tray_rep/al/slurm/al_test_array.sbatch     (N = lines - 1)
# Needs before submit: bimanual_data/tray_rep/al/online_calib_cl.json (closed-loop lam; written by al/calibrate_lam.py) and al/voi/voi_{normal,stressed}.json (al/build_voi.py).
# Slurm gives 2 CPUs per job (no --cpus-per-task). Temp on the shared data disk, emptied with find -delete.
# SIMULATION / SAVED DATA ONLY: no hardware, no network, no GPU. Resumable: rerun = resume.
set -uo pipefail
export TMPDIR=/common/users/ss5772/bimanual_data/slurm_tmp/altest_${SLURM_JOB_ID:-local}_${SLURM_ARRAY_TASK_ID:-0}
mkdir -p $TMPDIR /common/users/ss5772/bimanual_data/tray_rep/al/logs /common/users/ss5772/bimanual_data/tray_rep/al/runs
export MPLCONFIGDIR=$TMPDIR/mpl XDG_CACHE_HOME=$TMPDIR/cache PYTHONPYCACHEPREFIX=$TMPDIR/pyc NUMBA_CACHE_DIR=$TMPDIR/numba
export PYTHONPATH=/common/users/ss5772/bimanual CUDA_VISIBLE_DEVICES=
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMBA_NUM_THREADS=1 PYTHONUNBUFFERED=1
export BIMANUAL_MU_EFF_FILE=/common/users/ss5772/bimanual_data/tray_rep/calib_v2/mu_eff_calib.json BIMANUAL_F5_EPS_A=0.0
unset BIMANUAL_LEGACY_PIN
PY=/common/users/ss5772/miniforge3/envs/mujoco_ur5e/bin/python
cd /common/users/ss5772/bimanual
TASKS=${TASKS_FILE:-world_model/v2/tray_rep/al/slurm/al_test_tasks.txt}
ARGS=$(sed -n "$(( ${SLURM_ARRAY_TASK_ID:-0} + 1 ))p" $TASKS)
echo "[altest] host=$(hostname) job=${SLURM_JOB_ID:-local} task=${SLURM_ARRAY_TASK_ID:-0} args=$ARGS $(date -u +%FT%TZ)"
$PY -m world_model.v2.tray_rep.al.run_al $ARGS --workers 2
rc=$?
find "$TMPDIR" -delete 2>/dev/null
echo "EXIT $rc"
exit $rc
